# The frontend API used by the dashboard.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8001

# Optional. Defaults to mtn.com when omitted. Set an empty value in code only
# if your deployment intentionally allows users from every email domain.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=mtn.com

# JWT secret used by the backend to sign access tokens.
# Must match the JWT_SECRET in the backend environment.
JWT_SECRET=dev-secret-change-me-in-production